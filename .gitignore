# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the committed env templates
!.env.schema
!.env.example

# design tooling cache
.impeccable/

# --- Public repository safety net: personal data, secrets, backups ---

# real data and exports must never be committed; synthetic fixtures live in tests/fixtures
/private/
/exports/
/backups/
*.csv
!tests/fixtures/**/*.csv
*.xlsx
*.dump
*.sql.gz
*.sqlite

# keys and credentials
*.key
*.p12
*.pfx
*.crt
service-account*.json
.supabase/

# test and tool output
/playwright-report/
/test-results/
/blob-report/
*.log

# local editor, OS and assistant settings
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
Desktop.ini
.claude/settings.local.json
.claude/worktrees/
