# Environment variables. Declared here, validated at build and start by lib/env.ts (keep the two
# in step). Never put values in this file: real values live in .env.local (git-ignored) and in
# the Vercel project settings.
#
# Local development against staging: copy the Supabase URL and keys from the staging project.
# CI and local Supabase: `bun scripts/supabase-env.ts` prints the values.
# Builds without secrets (CI static checks) set SKIP_ENV_VALIDATION=1. It applies only to
# `next build`; a running server always validates.

# Supabase
# ---
# @required @type=url
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (public) key, shipped to the browser
# @required
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses row-level security, server-only
# @required @sensitive
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend), required from A-04
# ---
# @optional @sensitive
RESEND_API_KEY=
# @optional
EMAIL_FROM=

# Tooling
# ---
# Set to 1 to skip validation, only for builds that cannot have secrets
# @optional
SKIP_ENV_VALIDATION=
# Used by database tests and scripts against local Supabase only
# @optional @sensitive
DATABASE_URL=
# Email of the first admin, read only by scripts/seed-admin.ts. Set it for that one command.
# @optional @sensitive
SEED_ADMIN_EMAIL=
